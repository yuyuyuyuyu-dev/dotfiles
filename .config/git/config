[init]
	defaultBranch = main

[alias]
	diff = diff -w

	root = rev-parse --show-toplevel

	fetch = fetch -p
	pull = pull -p

	copy-changed-files = !"f(){ git diff --name-only HEAD | xargs -I{} dirname {} | xargs -tI{} mkdir -p ${1}/{} && git diff --name-only HEAD | xargs -tI{} cp {} ${1}/{}; }; f"

[merge]
	ff = true

[pull]
	ff = true

[include]
    path = ~/Documents/GitHub/dotfiles-private/.config/git/config
